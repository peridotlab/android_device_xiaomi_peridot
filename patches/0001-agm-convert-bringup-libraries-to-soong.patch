diff --git a/ipc/HwBinders/agm_ipc_client/Android.bp b/ipc/HwBinders/agm_ipc_client/Android.bp
new file mode 100644
index 0000000..2527ad2
--- /dev/null
+++ b/ipc/HwBinders/agm_ipc_client/Android.bp
@@ -0,0 +1,38 @@
+//
+// Copyright (C) 2024 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+cc_library_headers {
+    name: "libagmclient_headers",
+    export_include_dirs: ["inc"],
+    vendor: true,
+}
+
+cc_library_shared {
+    name: "libagmclient",
+    owner: "qti",
+    vendor: true,
+
+    cflags: ["-Wno-format"],
+
+    srcs: [
+        "src/agm_client_wrapper.cpp",
+        "src/AGMCallback.cpp",
+    ],
+
+    include_dirs: ["hardware/qcom-caf/sm8650/audio/agm/ipc/HwBinders/agm_ipc_client/inc"],
+
+    shared_libs: [
+        "libhidlbase",
+        "libutils",
+        "liblog",
+        "libcutils",
+        "libhardware",
+        "libbase",
+        "vendor.qti.hardware.AGMIPC@1.0",
+    ],
+
+    header_libs: ["libagm_headers"],
+}
